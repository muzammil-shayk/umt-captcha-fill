{
  "manifest_version": 3,
  "name": "UMT Captcha Fill",
  "version": "1.0.0",
  "description": "Unofficial. Copies the plain-text captcha into the captcha field on the online.umt.edu.pk login page. Never touches your ID or password, never submits, stores nothing.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://online.umt.edu.pk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "portal-captcha-autofill@muzammil-shayk.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
